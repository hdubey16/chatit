# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea

# OS
Thumbs.db

# logs
*.log

# ralph agent runtime (logs/status, not source)
.ralph/live.log
.ralph/logs/
.ralph/status.json
.ralph/progress.json

# local sqlite / vector db files, if any get added
*.sqlite
*.sqlite3
*.db
